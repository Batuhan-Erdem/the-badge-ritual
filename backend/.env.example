# OpenAI Settings
# If OPENAI_API_KEY is provided, the application will use OpenAI models.
# If it is missing or commented out, it will fall back to local AI models.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# ==============================================================
# Local AI Settings (Fallback models)
# Used only if OPENAI_API_KEY is NOT set.
# ==============================================================

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Stable Diffusion API Setting (e.g. A1111 or Forge with --api)
SD_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img

# Edge-TTS Settings (Free, high-quality Microsoft voices)
EDGE_TTS_VOICE=en-US-ChristopherNeural
